# MongoDB
# Local Docker: docker compose up -d
MONGODB_URI=mongodb://localhost:27017/imdb-tracker
# Vercel: use MongoDB Atlas (localhost will not work)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/imdb-tracker?retryWrites=true&w=majority

# OMDb — https://www.omdbapi.com/apikey.aspx
# Required at build time and runtime on Vercel
OMDB_API_KEY=

# Clerk — https://dashboard.clerk.com/last-active?path=api-keys
# Add your Vercel domain in Clerk → Configure → Domains
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes (relative URLs work on Vercel)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk webhook signing secret
# After deploy, point Clerk webhook to https://YOUR_APP.vercel.app/api/webhooks
CLERK_WEBHOOK_SIGNING_SECRET=
